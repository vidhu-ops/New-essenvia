# Database — SQLite for local dev; use PostgreSQL in production (ca-central-1)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/essentra?schema=public"

# Session signing (required in production — min 32 chars)
AUTH_SECRET="change-me-in-production-use-openssl-rand"

# Public site URL (magic links, Stripe redirects)
NEXT_PUBLIC_APP_URL="http://127.0.0.1:4321"

# Stripe Billing — omit for demo checkout (local DB only)
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ESSENTIAL="price_..."
# STRIPE_PRICE_FAMILY="price_..."
# STRIPE_PRICE_PLUS="price_..."

# Optional: transactional email (Resend). Without it, magic links log to server console in dev.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Essentra <hello@essentra.ca>"
